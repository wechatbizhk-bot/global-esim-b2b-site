# ---------------------------------------------------------------------------
# CONFIDENTIAL SOURCE MATERIAL — keep these OUT of the public repository.
#
# The coverage table in assets/js/coverage-data.js is generated from the
# partner cost sheet. Publishing the spreadsheet itself, the signed agreements,
# invoices or the internal requirements document would expose your commercial
# terms in full. Keep them local, or in a separate private repository.
# ---------------------------------------------------------------------------
*.xlsx
*.docx
*.pptx
*.msg
wechatbiz_cost_SIM*
Master agreement*
INVCMM*
eSIM对接需求*
whitelabel_2025*

# ---------------------------------------------------------------------------
# OPTIONAL — if you would rather not publish your wholesale rates at all,
# uncomment the next line. The coverage table and the order builder will then
# show coverage without prices. Also set showRates: false in config.js so the
# rest of the site stops quoting figures.
# ---------------------------------------------------------------------------
# assets/js/coverage-data.js

.next/

.env

.env.*
.vercel
.env*
